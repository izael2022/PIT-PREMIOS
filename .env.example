# Modelo de configuração do PIT PRÊMIOS.
# Copie os valores para as variáveis do painel da Discloud.
# Não coloque tokens, chaves reais ou dados pessoais neste arquivo do GitHub.
BOT_TOKEN=COLOQUE_O_TOKEN_DO_BOT_AQUI
ADMIN_IDS=SEU_ID_TELEGRAM
DATABASE_PATH=data/pit_premios.db
POINTS_PER_REFERRAL=1000
DAILY_REWARDS=3,4,5,6,7,8,10
MIN_REDEEM_POINTS=1000
# Gere uma chave exclusiva de produção com:
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Cole o resultado real somente no painel da hospedagem. Nunca use este texto como chave.
BACKUP_ENCRYPTION_KEY=COLOQUE_A_CHAVE_BASE64_DE_32_BYTES_AQUI
# Opcional: URL HTTPS secreta de um monitor externo.
MONITOR_HEARTBEAT_URL=
# Opcional: quantidade de trabalhadores (o código limita entre 4 e 9).
BOT_WORKERS=9
